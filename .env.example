OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# Sesión conversacional (ventana deslizante: pares user+assistant)
SESSION_MAX_TURNS=6
MAX_CONVERSATION_TURNS=6
MAX_SUMMARY_CHARS=4000
MAX_ANCHORS=20
MAX_ATTACHMENT_CHARS=60000
METADATA_EXTRACTOR_MODEL=gpt-4o-mini
ENABLE_ACB=true
ACB_MAX_ITERATIONS=2
MAX_ATTACHMENT_BYTES=5000000
MAX_ATTACHMENTS_PER_REQUEST=5

# URL base del API (la usa el cliente Streamlit)
ESTIMATOR_API_BASE_URL=http://localhost:8000

APP_ENV=development
LOG_LEVEL=DEBUG

# Sesión 10 — retrieval híbrido + reranking
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_CANDIDATE_POOL_SIZE=50
RETRIEVAL_TOP_K=5
RRF_SMOOTHING_K=60
